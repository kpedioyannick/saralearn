# Copier en .env et renseigner. Aucune valeur réelle ici.
SARA_DB=/var/www/saralearn/data/sara.db
SARA_CORS=http://localhost:5174,http://127.0.0.1:5174
# openssl rand -hex 32
SARA_ADMIN_TOKEN=

# ----- Moteur de génération ------------------------------------------
# Renseigner DEEPSEEK_API_KEY suffit à basculer sur l'API officielle :
# l'URL par défaut suit la clé. Laisser vide retombe sur le proxy local
# (127.0.0.1:8003), qui ne parle pas à l'API facturée.
DEEPSEEK_API_KEY=
# Facultatif — valeurs par défaut entre parenthèses.
# SARA_LLM_URL=            (https://api.deepseek.com/chat/completions)
# SARA_LLM_MODEL=          (deepseek-chat) ; deepseek-reasoner pour le raisonnement
# SARA_LLM_TIMEOUT=        (180) secondes
# SARA_LLM_RETRIES=        (3) reprises sur 429 et 5xx
# SARA_LLM_TEMPERATURE=    (défaut du fournisseur)

# ----- Voix -----------------------------------------------------------
# Google Cloud Text-to-Speech — le même moteur que la classe avec Sara
# (voix WaveNet, MP3). La clé existe déjà pour ce service : elle est dans
# le .env d'AnythingLLM sous le même nom. À recopier ici, pas à partager
# entre services.
# Sans clé : POST /tts répond 501 et le front retombe sur la voix du
# navigateur — l'app parle toujours, moins bien.
GOOGLE_TTS_API_KEY=
# Facultatif — valeurs par défaut entre parenthèses.
# SARA_TTS_CACHE=          (<projet>/data/tts-cache) un texte n'est facturé qu'une fois
# SARA_TTS_TIMEOUT=        (30) secondes

# Unsplash — photos d'ambiance des exercices. La clé d'ACCÈS suffit :
# elle ouvre /search/photos. La clé secrète (OAuth) n'est pas utilisée.
# Sans clé, la recherche d'image ne fait rien et l'exercice reste sans
# photo — ce qui est le comportement normal, pas une panne.
UNSPLASH_ACCESS_KEY=

# Pexels et Pixabay — LE RELAIS, quand Unsplash est à sec. Les trois sont
# essayées dans cet ordre : Unsplash pour la beauté, Pexels pour le débit
# (200/heure contre 50), Pixabay pour le filet (100 par MINUTE). Chacune
# est facultative et une banque sans clé est simplement sautée.
#
# Attention à une différence de fond : Pixabay INTERDIT le lien direct
# permanent, là où Unsplash l'impose. Ses photos sont donc rapatriées
# dans media/photos/ — voir api/photos.py.
#
#   Pexels  : https://www.pexels.com/api/  (inscription, clé immédiate)
#   Pixabay : https://pixabay.com/api/docs/ (inscription, clé immédiate)
PEXELS_API_KEY=
PIXABAY_API_KEY=
